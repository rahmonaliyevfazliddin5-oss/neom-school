# ==============================================================================
# NEOM School Platform - Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=neom_secret_pg_2026
POSTGRES_DB=neom_school
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:neom_secret_pg_2026@localhost:5432/neom_school?schema=public"

# Redis Configuration (Cache, Sessions, Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=neom_secret_redis_2026
REDIS_URL="redis://:neom_secret_redis_2026@localhost:6379"

# Web Client & CORS
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Security Keys & Cryptography
# 1. Server Password Pepper (HMAC-SHA256 applied before Argon2id)
PASSWORD_PEPPER="d6f78e9b1c2a3f4e5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f"

# 2. Login Search Index Key (HMAC-SHA256 of normalized login)
LOGIN_HMAC_KEY="a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90"

# 3. Login Encryption Key (AES-256-GCM, 32 bytes hex)
LOGIN_ENC_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 4. JWT Access Token Secret (15-minute tokens)
JWT_SECRET="neom_school_super_secure_jwt_access_token_secret_key_2026_xyz_789"

# 5. Cookie Signing Secret (for signed cookies & double-submit CSRF)
COOKIE_SECRET="neom_cookie_secret_key_strictly_random_bytes_2026_abcdef_123456"

# Initial Database Seed Passwords (Required for seed.ts - mustChangePassword=true)
SEED_DIRECTOR_PASSWORD="DirectorSecurePassword2026!"
SEED_ZAVUCH_PASSWORD="ZavuchSecurePassword2026!"
SEED_TEACHER_PASSWORD="TeacherSecurePassword2026!"

# Rate Limiting & Session Configuration
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
MAX_SESSIONS_PER_USER=3
